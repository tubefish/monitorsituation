# Exclude local desktop build artifacts and sidecar binaries from deployments
# These files are large and not needed by the Vercel-hosted frontend/API

# Tauri build outputs
src-tauri/target/
src-tauri/bundle/

# Sidecar and bundled node binaries
src-tauri/sidecar/
src-tauri/**/node

# macOS disk images and app bundles
**/*.dmg
**/*.app

# Rust/Cargo build artifacts (safety)
target/

# Common local artifacts
.DS_Store

# Never deploy api test files: every non-underscore file under api/ becomes a
# live serverless function, and a deployed *.test.mjs executes its whole
# node:test suite (production env + Sentry) on every request (WORLDMONITOR-VD).
# Guarded by tests/deploy-config.test.mjs.
api/**/*.test.mjs

# $MONITOR production API allowlist.
# Vercel discovers /api routes before the build command runs, so unused routes
# must be excluded here rather than deleted from the temporary build workspace.
# Keep top-level shared helper modules (api/_*) plus only the route families the
# current $MONITOR dashboard needs.
api/*
!api/_*
!api/bootstrap.js
!api/health.js
!api/rss-proxy.js
!api/wm-session.js
!api/conflict/
!api/economic/
!api/infrastructure/
!api/intelligence/
!api/military/
!api/radiation/
!api/unrest/
!api/youtube/

# Live News only needs the YouTube live endpoint.
api/youtube/*
!api/youtube/live.js

# Build-time inventory support only. These four files are parsed as source text
# during npm install; they are not part of the $MONITOR runtime feature set.
!api/mcp/
api/mcp/*
!api/mcp/ui/
api/mcp/ui/*
!api/mcp/ui/registry.ts
!api/mcp/ui/shell.ts
!api/mcp/registry/
api/mcp/registry/*
!api/mcp/registry/rpc-tools.ts
!api/mcp/registry/cache-tools.ts
